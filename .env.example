# Database connection address read by app/settings.py.
# The +psycopg prefix selects the psycopg 3 driver (ADR 0017).
DATABASE_URL=postgresql+psycopg://workorders:change-me@localhost:5432/workorders

# Database used by the test suite. A separate database, so tests never
# touch development data.
TEST_DATABASE_URL=postgresql+psycopg://workorders:change-me@localhost:5432/workorders_test

# Signing key for login tokens (JWT, HS256). Retired in R1 (ADR 0004).
# Generate a value with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me